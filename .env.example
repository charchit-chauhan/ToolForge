# Copy this file to .env and provide your own values.
# Never commit .env or share API keys publicly.
SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development

# MySQL example (create the database first):
# DATABASE_URL=mysql+pymysql://toolforge_user:YOUR_PASSWORD@localhost:3306/toolforge
# Local fallback is SQLite until DATABASE_URL is configured.
DATABASE_URL=sqlite:///toolforge_dev.db

# Translation providers (optional)
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
