# Tool Forge — translation provider keys (optional but recommended)
# Copy to .env and fill in at least one key for reliable translation.

# DeepL Free API key (recommended) — https://www.deepl.com/pro-api
# Free tier: 500,000 characters / month. Key often ends with :fx
DEEPL_API_KEY=

# Google Cloud Translation API key — https://console.cloud.google.com/
# Enable "Cloud Translation API", create an API key
GOOGLE_TRANSLATE_API_KEY=

# Self-hosted or hosted LibreTranslate
# Example: http://localhost:5000  or  https://your-libretranslate-host
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Flask secret (change in production)
SECRET_KEY=toolforge-dev-secret-change-me
